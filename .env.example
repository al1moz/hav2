# Copier en .env et remplacer chaque valeur. Le fichier .env n'est jamais versionné.
DB_HOST=db
DB_PORT=3306
DB_NAME=consov2
DB_USER=consov2
DB_PASS=a-remplacer
# Utilisé seulement par le Docker local (conteneur MySQL).
DB_ROOT_PASSWORD=a-remplacer

# Ancienne base (table releve), lue uniquement par bin/migrate-releve.php.
LEGACY_DB_HOST=db
LEGACY_DB_PORT=3306
LEGACY_DB_NAME=legacy
LEGACY_DB_USER=root
LEGACY_DB_PASS=a-remplacer

# Fuseau d'affichage et de découpage des journées.
APP_TIMEZONE=Europe/Paris
# Ports du Docker local (changer si déjà pris sur la machine).
WEB_PORT=8080
DB_LOCAL_PORT=3307

# 1 en local pour voir les erreurs, 0 en production.
APP_DEBUG=1

# Facultatif : ancienne adresse de la page tablette, si la tablette est déjà réglée dessus
# (ex. /ancien/chemin.php). Elle reste hors du dépôt car elle peut nommer un lieu.
# La page répond toujours aussi sur /tablette.
TABLET_LEGACY_PATH=

# Discussion avec Claude (bouton « Demander à Claude ») : clé d'API créée sur console.anthropic.com.
# Sans clé, le bouton n'apparaît pas. Les réglages sont dans l'administration.
ANTHROPIC_API_KEY=
